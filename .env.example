# Vercel Blob: lo añade Vercel al conectar el Blob store al proyecto (ver docs/preventa.md)
BLOB_STORE_ID=
# (stores antiguos) BLOB_READ_WRITE_TOKEN=
# URL del Web App de Google Apps Script que escribe en el Google Sheet (ver docs/google-sheets.md)
GOOGLE_SHEETS_WEBHOOK_URL=
# Secreto compartido: el mismo valor que pongas en el Apps Script (SECRET)
GOOGLE_SHEETS_SECRET=
# Opcional: dominio final para og:image / canonical (p. ej. https://olem.studio)
NEXT_PUBLIC_SITE_URL=
